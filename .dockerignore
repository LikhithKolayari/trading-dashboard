# Ignore node modules and build caches
node_modules
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Git
.git
.gitignore

# Local env files
.env
.env.*
!.env.example

# Editor/OS
.vscode
.DS_Store

# Tests and coverage
coverage
**/__tests__

# Vite cache
.vite

# Build outputs (except we build inside the container)
dist
