# syntax=docker/dockerfile:1.7-labs

# Railway-compatible Dockerfile (no VOLUME instruction)
# To persist data, configure a Railway Volume and mount it at /app/server/data
# Docs: https://docs.railway.com/reference/volumes

# ---------- FRONTEND BUILD STAGE ----------
FROM node:20-alpine AS frontend-builder

# Vite uses VITE_* envs at build time. Default to relative API.
ARG VITE_API_BASE=/api
ENV VITE_API_BASE=${VITE_API_BASE}

WORKDIR /app

# Install build dependencies only for the frontend
COPY package.json package-lock.json ./
COPY tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts ./
COPY index.html ./
COPY public ./public
COPY src ./src

RUN --mount=type=cache,id=npm-cache-frontend,target=/root/.npm \
    npm ci && \
    npm run build

# ---------- BACKEND DEPENDENCIES BUILD (for native modules like bcrypt) ----------
FROM node:20-alpine AS backend-deps
WORKDIR /app/server
# Build toolchain needed for native addons on Alpine
RUN apk add --no-cache python3 make g++
COPY server/package.json server/package-lock.json ./
RUN --mount=type=cache,id=npm-cache-backend,target=/root/.npm npm ci --omit=dev

# ---------- BACKEND RUNTIME STAGE ----------
FROM node:20-alpine AS runtime

ENV NODE_ENV=production
WORKDIR /app/server

# Copy production node_modules built with toolchain
COPY --from=backend-deps /app/server/node_modules ./node_modules

# Copy backend source
COPY server ./

# Copy the built frontend from the builder and place it where Express serves it
# Express serves from /app/client per server/index.js
COPY --from=frontend-builder /app/dist /app/client

# Prepare data directory for JsonDB and set permissions (Railway volume should mount here)
RUN mkdir -p /app/server/data && chown -R node:node /app/server

# Run as non-root for security (node user exists in the base image)
USER node

# Expose the backend port (Railway provides PORT env and maps it)
EXPOSE 3001

# Healthcheck using Node (avoid installing curl/wget)
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/health',r=>{process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))"

# IMPORTANT: No VOLUME instruction (Railway forbids it). Configure volumes in Railway UI.

# Start the server
CMD ["node", "index.js"]
